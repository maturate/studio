# Copy to .env for local dev. Never commit the real .env file.

# --- Database (Dockerized Postgres, see docker-compose.yml) ---
# Mapped to host port 5433, not 5432 — avoids clashing with a native/Homebrew
# Postgres already running on 5432 on some dev machines.
DATABASE_URL=postgresql://superos:superos@localhost:5433/superos_workflow_studio

# --- Redis (queue / cache, see docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Generation providers ---
# Gemini image/TTS/Omni Flash/Veo + context embeddings, via Vertex AI /
# Gemini Enterprise Agent Platform (OAuth2 service account, not an API key).
# Auth is auto-discovered by google-auth-library — set ONE of:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#   or run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=
# AnyFast (anyfast.ai) — proxies Seedance, Seedream, Kling behind one key.
ANYFAST_API_KEY=
# Apify (apify.com) — downloads YouTube/Instagram source video before STT,
# since ElevenLabs' own source_url fetch is unreliable against those hosts.
APIFY_API_KEY=

# --- Object storage (Cloudflare R2 / S3-compatible) ---
# Local defaults point at the Dockerized MinIO in docker-compose.yml.
# For production, swap these for real Cloudflare R2 credentials —
# the storage adapter (packages/storage) is the same S3-compatible client
# either way, nothing else in the app needs to change.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=superos-assets
STORAGE_ACCESS_KEY_ID=superos
STORAGE_SECRET_ACCESS_KEY=superos-dev-key

# --- Seed data ---
# Comma-separated emails to allowlist on `npm run db:seed`.
SEED_ALLOWED_EMAILS=
